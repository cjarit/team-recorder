# Teams Recorder — config template
# Copy to .env and fill in values

# โฟลเดอร์บันทึกไฟล์ (สร้างอัตโนมัติถ้าไม่มี)
RECORDING_DIR=~/Documents/Teams Recording

# icalBuddy path (ปล่อยว่างถ้าอยู่ใน PATH)
ICAL_BUDDY_PATH=

# Optional override path to recorder binary
# Default: recorder/recorder
RECORDER_BIN=

# Optional mic input device UID from: recorder/recorder --list-devices
# Applies to microphone input only. System audio always uses ScreenCaptureKit default.
AUDIO_INPUT_DEVICE_UID=

# macOS notifications on start/stop/save/error (1 = on, 0/false/no = off)
NOTIFY=1
